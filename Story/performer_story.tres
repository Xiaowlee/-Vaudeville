[sub_resource type="Resource" id="Beat01"]
resource_name = "Beat 01"
script = ExtResource("Beat")
text = "She is walking home at night."
visual = ExtResource("2_83t8q")
beat_id = "Beat01"

[sub_resource type="Resource" id="Beat02"]
resource_name = "Beat 02"
script = ExtResource("Beat")
text = "A streetlight turns on above her."
visual = ExtResource("2_83t8q")
beat_id = "Beat02"

[sub_resource type="Resource" id="Beat03"]
resource_name = "Beat 03"
script = ExtResource("Beat")
text = "She looks down. A dark silhouette waits at her feet."
visual = ExtResource("3_41bcr")
beat_id = "Beat03"

[sub_resource type="Resource" id="Beat04"]
resource_name = "Beat 04"
script = ExtResource("Beat")
text = "Her shadow has stopped moving."
visual = ExtResource("4_h5i2t")
beat_id = "Beat04"

[sub_resource type="Resource" id="1_QUESTION"]
resource_name = "QUESTION"
script = ExtResource("Option")
category = "QUESTION"
accepted_answers = PackedStringArray("who are you", "what are you", "why are you here")

[sub_resource type="Resource" id="1_REJECTION"]
resource_name = "REJECTION"
script = ExtResource("Option")
category = "REJECTION"
accepted_answers = PackedStringArray("leave me alone", "go away", "stop following me")

[sub_resource type="Resource" id="1_RECOGNITION"]
resource_name = "RECOGNITION"
script = ExtResource("Option")
category = "RECOGNITION"
accepted_answers = PackedStringArray("you\'re me", "you are me", "I know you", "I remember you")

[sub_resource type="Resource" id="1_GREETING"]
resource_name = "GREETING"
script = ExtResource("Option")
category = "GREETING"
accepted_answers = PackedStringArray("hello", "can you hear me", "are you okay")

[sub_resource type="Resource" id="1_UNKNOWN"]
resource_name = "UNKNOWN"
script = ExtResource("Option")
category = "UNKNOWN"
accepted_answers = PackedStringArray()

[sub_resource type="Resource" id="Interaction1"]
script = ExtResource("Interaction")
prompt_a = "Say her line:

“Who are you?”"
prompt_c = "What does she say to the shadow?"
options = Array[ExtResource("Option")]([SubResource("1_QUESTION"), SubResource("1_REJECTION"), SubResource("1_RECOGNITION"), SubResource("1_GREETING"), SubResource("1_UNKNOWN")])
allowed_categories_a = PackedStringArray("QUESTION")

[sub_resource type="Resource" id="Beat05"]
resource_name = "Beat 05"
script = ExtResource("Beat")
text = "The shadow slowly raises its head and looks at her."
visual = ExtResource("5_mxg1p")
beat_id = "Beat05"
interaction = SubResource("Interaction1")

[sub_resource type="Resource" id="Beat06"]
resource_name = "Beat 06"
script = ExtResource("Beat")
text = "The shadow reacts to what she says."
visual = ExtResource("6_n1lx1")
beat_id = "Beat06"

[sub_resource type="Resource" id="Beat07"]
resource_name = "Beat 07"
script = ExtResource("Beat")
text = "Rain begins to fall."
visual = ExtResource("7_12fyy")
beat_id = "Beat07"

[sub_resource type="Resource" id="Beat08"]
resource_name = "Beat 08"
script = ExtResource("Beat")
text = "She sprints forward for shelter."
visual = ExtResource("8_3yc5a")
beat_id = "Beat08"

[sub_resource type="Resource" id="Resource_n1lx1"]
resource_name = "Beat 11"
script = ExtResource("Beat")
text = "The rain gets heavier.	"
visual = ExtResource("9_h5i2t")
beat_id = "Resource_n1lx1"

[sub_resource type="Resource" id="Beat09"]
resource_name = "Beat 09"
script = ExtResource("Beat")
text = "But she stops."
visual = ExtResource("9_rq3bo")
beat_id = "Beat09"

[sub_resource type="Resource" id="Beat10"]
resource_name = "Beat 10"
script = ExtResource("Beat")
text = "She turns her head back."
visual = ExtResource("10_eubre")
beat_id = "Beat10"

