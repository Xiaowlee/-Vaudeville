"3_18": {"signalValue": "frame:{\"id\": \"A2_0_DeclarationDay\", \"group\": \"Act 2\", \"cue\": \"NEITHER DO I. IT GET A LITTLE NERVOUS.\", \"routes\": [\"cue\", \"takeover\"], \"effects\": [{\"set\": {}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Before you can start the game, on the second screen, you see a spark of light cast on a thin long lines. It runs through quickly before disappear. It happens almost immediate.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"And then the Stage manager standing from the other side (on your computer), elegantly walk out, still with his despise look on you.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"One month passes.\\nThe day of the celebration finally arrives.\\nPeople from around the kingdom gather for the princess's birthday and declaration.\"}, {\"kind\": \"stage\", \"speaker\": \"\", \"text\": \"The curtain once again unveil\\nThe stage changes from the family home into the preparation for the princess's eighteenth birthday.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The hall is crowded.\\nMusicians prepare.\\nServants and performers move around the stage.\\nThe princess is preparing to appear before everyone.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Both of the actors, including the one you are controlling, walks out.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 1 approaches you from the side, gently nudge the MC elbow.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Look at that, child.\\nToday is the day.\\nI can not believe it.\\nYou're gonna be a true adult.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The MC girl, ironically look confused, she keeps staring at the actor. But not for long because the cue has again appear on the other side.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"NEITHER DO I. IT GET A LITTLE NERVOUS.\"}], \"context\": \"\", \"player_task\": \"Respond in context: Read cue / express nerves\", \"author_notes\": [\"Response words above are editable. USE UNIVERSAL uses Universal responses. Takeover wording is provisional; review before recording. Buttons in Play simulate player meanings.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"cue\": {\"meaning\": \"Read cue / express nerves\", \"destination\": \"A2_1_Entrance\"}}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"response_overrides\": {\"SILENCE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: We are waiting for your line.\"}, \"OFFSCRIPT\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Stay with the script.\"}, \"UNCLEAR\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}, \"TECHNICAL_FAILURE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}}, \"template_version\": 2, \"conversation\": \"A2_0_DeclarationDay\", \"intro_exempt\": false, \"takeover_start\": \"TAKEOVER::A2_0_DeclarationDay\", \"mic_check_reply\": \"Stage Manager: It seems some cat has stolen your tongue. Do you mind checking your “device” again?\"}",
