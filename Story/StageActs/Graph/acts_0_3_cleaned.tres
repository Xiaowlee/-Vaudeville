"3_19": {"signalValue": "frame:{\"id\": \"A2_1_Entrance\", \"group\": \"Act 2\", \"cue\": \"LEFT / RIGHT\", \"routes\": [\"choice_0\", \"choice_1\", \"takeover\"], \"effects\": [{\"set\": {\"entrance\": \"left\"}}, {\"set\": {\"entrance\": \"right\"}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"What, I am sure you can do great things. You are the Millers.\\nYou are destined to be a great figure since you were born.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"She looks toward the crowded entrance.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"But don't you think it's getting difficult to move through there.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"How about we take a detour from the main gate. Which entrance should we use?\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"As you tried to look on your phone, expect a line, something else happen.\\nThe staff hands out a very sketchy unfinished writing, the ink droplet can be seen on the while board.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The cue card does not contain a sentence this time.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"LEFT / RIGHT\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The Actor and the audience are waiting for you\"}], \"context\": \"\", \"player_task\": \"Respond in context: Left / western stairs; Right / eastern entrance\", \"author_notes\": [\"Response words above are editable. USE UNIVERSAL uses Universal responses. Takeover wording is provisional; review before recording. Buttons in Play simulate player meanings.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"choice_0\": {\"meaning\": \"Left / western stairs\", \"destination\": \"A2_1_Left\"}, \"choice_1\": {\"meaning\": \"Right / eastern entrance\", \"destination\": \"A2_1_Right\"}}, \"bounded_evidence\": {\"choice_0\": [\"left\", \"west\", \"western\"], \"choice_1\": [\"right\", \"east\", \"eastern\"]}, \"input_mode\": \"speech\", \"response_overrides\": {\"SILENCE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: We are waiting for your line.\"}, \"OFFSCRIPT\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Stay with the script.\"}, \"UNCLEAR\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}, \"TECHNICAL_FAILURE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}}, \"template_version\": 2, \"conversation\": \"A2_1_Entrance\", \"intro_exempt\": false, \"takeover_start\": \"TAKEOVER::A2_1_Entrance\", \"mic_check_reply\": \"Stage Manager: It seems some cat has stolen your tongue. Do you mind checking your “device” again?\"}",
