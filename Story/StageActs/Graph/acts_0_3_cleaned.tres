nished writing, the ink droplet can be seen on the while board.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The cue card does not contain a sentence this time.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"LEFT / RIGHT\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The Actor and the audience are waiting for you\"}], \"context\": \"\", \"player_task\": \"Choose an entrance verbally.\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"choice_0\": {\"meaning\": \"Left.\", \"destination\": \"A2_1_Left\"}, \"choice_1\": {\"meaning\": \"Right.\", \"destination\": \"A2_1_Right\"}}, \"response_overrides\": {\"OFFSCRIPT\": {\"action\": \"route\", \"route\": \"choice_2\"}}, \"bounded_evidence\": {\"choice_0\": [\"left\", \"west\", \"western\"], \"choice_1\": [\"right\", \"east\", \"eastern\"]}, \"input_mode\": \"speech\", \"narrative_purpose\": \"\", \"mc_behaviour\": [], \"npc_behaviour\": [], \"assets_required\": [], \"state_changes\": {}, \"missing_logic\": []}"
