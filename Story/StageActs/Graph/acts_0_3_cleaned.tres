"3_29": {"signalValue": "frame:{\"id\": \"A2_6_ScriptChange\", \"group\": \"Act 2\", \"cue\": \"AGREE\", \"routes\": [\"yes\", \"no\", \"choice_2\", \"choice_3\", \"takeover\"], \"effects\": [{\"set\": {\"declarationAnswer\": \"yes\"}}, {\"set\": {\"declarationAnswer\": \"no\"}}, {\"set\": {\"declarationAnswer\": \"unclear\"}}, {\"set\": {\"declarationAnswer\": \"changed\"}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"ACTOR 1 straightens your dress, while waiting for the man to rush to their place.\\nThe light of the stage focus on them as everything else start to fall into the dark.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Right. Now. Before you make the declaration\\n\\nI just want to make some confirmation.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"She swiftly leaves her breadth out, take a slow moment before she continues\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"You'll tell everyone that you're entering the writing profession, won't you?\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"She looks at you attentively.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"All the eyes of the audience are casting upon YOU. (including the MC)/\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"You wait for the cue.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Nothing.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"ACTOR 1 looks at you expectantly, eyes landing on you waiting for your next move.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Then, late, the card changes.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"AGREE\"}], \"context\": \"\", \"player_task\": \"Respond in context: Yes; No; Uncertain; Changed my mind\", \"author_notes\": [\"Response words above are editable. USE UNIVERSAL uses Universal responses. Takeover wording is provisional; review before recording. Buttons in Play simulate player meanings.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"yes\": {\"meaning\": \"Yes\", \"destination\": \"A2_7_Agree\"}, \"no\": {\"meaning\": \"No\", \"destination\": \"A2_7_Decline\"}, \"choice_2\": {\"meaning\": \"Uncertain\", \"destination\": \"A2_7_NotSure\"}, \"choice_3\": {\"meaning\": \"Changed my mind\", \"destination\": \"A2_7_ChangeYourMind\"}}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"response_overrides\": {\"SILENCE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: We are waiting for your line.\"}, \"OFFSCRIPT\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Stay with the script.\"}, \"UNCLEAR\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}, \"TECHNICAL_FAILURE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}}, \"template_version\": 2, \"conversation\": \"A2_6_ScriptChange\", \"intro_exempt\": false, \"takeover_start\": \"TAKEOVER::A2_6_ScriptChange\", \"mic_check_reply\": \"Stage Manager: It seems some cat has stolen your tongue. Do you mind checking your “device” again?\"}",
