"3_17": {"signalValue": "frame:{\"id\": \"A1_5_EndAct1\", \"group\": \"Act 1\", \"cue\": \"\", \"routes\": [\"next\", \"next\"], \"effects\": [{\"set\": {}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"dialogue\", \"speaker\": \"MC\", \"text\": \"I'll be fine.\"}, {\"kind\": \"dialogue\", \"speaker\": \"MC\", \"text\": \"By the time, I will make more happy people reading my books than caring about the little bumps, pain in my finger.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"ACTOR 1 smiles.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Great. Now go on.\\n\\nWe should have a lot of work to do before your birthday comes.\\n\\nMe and father are gonna organize a big party.\\n\\nWe're gonna invite people all around the kingdom to visit, to attend your own birthday.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Preparations begin throughout the kingdom.\\nThe princess's eighteenth birthday is approaching.\\nIn this world, reaching eighteen is not only a birthday.\\nIt is also the moment when a young person stands before the people around them and announces the social position, vocation, or path they intend to follow as an adult.\"}, {\"kind\": \"stage\", \"speaker\": \"\", \"text\": \"Lights fade.\\nCurtains fall (what narrative transition could be here) is it that the player get pushed back to the main menu?)\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The bluish hue of  the curtain slightly takes on the tin of yellow, it push the player back to the main menu.\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"response_overrides\": {}, \"template_version\": 2}",
