"3_43": {"signalValue": "frame:{\"id\": \"A3_4_FollowPlay\", \"group\": \"Act 3\", \"cue\": \"\", \"routes\": [\"next\"], \"effects\": [{\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"You turn back toward ACTOR 1.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 2 watches you retreat into the performance.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"...All right.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"But the script won't answer everything.\\n\\nThe one who keeps pulling the string...\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"response_overrides\": {}, \"template_version\": 2}",
