"3_35": {"signalValue": "frame:{\"id\": \"A3_1_Actor2\", \"group\": \"Act 3\", \"cue\": \"STAGE MANAGER / IFB: — DO NOT ENGAGE. — CONTINUE THE PLAY.\", \"routes\": [\"next\"], \"effects\": [{\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"He does not look at her.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"He looks directly at you.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"A princess.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"A writer.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Her daughter.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"A pause.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Is that who you are?\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Your phone vibrates.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"You notice the stage manager himself now holds the cue board himself, writing the lines in red ink, capitalised the letter in an exaggerated tone.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"STAGE MANAGER / IFB: — DO NOT ENGAGE. — CONTINUE THE PLAY.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Before you can react, Actor 2 continues.\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"response_overrides\": {}, \"template_version\": 2}",
