LAY.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Before you can react, Actor 2 continues.\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"response_overrides\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"narrative_purpose\": \"\", \"mc_behaviour\": [], \"npc_behaviour\": [], \"assets_required\": [], \"state_changes\": {}, \"missing_logic\": []}"
