"3_2": {"signalValue": "frame:{\"id\": \"A1_0_Begin\", \"group\": \"Act 0 · Pre-show\", \"cue\": \"\", \"routes\": [\"yes\", \"no\", \"takeover\"], \"effects\": [{\"set\": {}}, {\"set\": {}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Bang\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The sound of stage light draws out a circle zone on the weirdly glittering blueish curtain\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The sound of acclaimed gentle man  claps reached across the theater hall.\\nHe walks out of the stage, eyes glancing down at the audience, his face half lit.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"He stands in the light zone, his height too tall so, with the lower part of his face bathed in light.\\nHe harrumphed.\\nStage Manager speaks before the performance begins.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Stage Manager\", \"text\": \"SILENCESSSs, everyone.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"In a gentle yet coarse voice, as if he is trying to hide something.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Stage Manager\", \"text\": \"We are now hopping upon a wonderful fairy-tale story that I'm sure you've never heard before.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Stage Manager\", \"text\": \"Without further ado...\\nLet the show begin.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The man still keep his gaze downward, waiting for your response\"}], \"context\": \"\", \"player_task\": \"Respond in context: Ready / yes; Not ready / no\", \"author_notes\": [\"Response words above are editable. USE UNIVERSAL uses Universal responses. Takeover wording is provisional; review before recording. Buttons in Play simulate player meanings.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"yes\": {\"meaning\": \"Ready / yes\", \"destination\": \"A1_1_0 PreshowHappy\"}, \"no\": {\"meaning\": \"Not ready / no\", \"destination\": \"A1_0_No\"}}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"response_overrides\": {\"SILENCE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: We are waiting for your line.\"}, \"OFFSCRIPT\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Stay with the script.\"}, \"UNCLEAR\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}, \"TECHNICAL_FAILURE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}}, \"template_version\": 2, \"conversation\": \"intro\", \"intro_exempt\": true, \"takeover_start\": \"TAKEOVER::A1_0_Begin\", \"mic_check_reply\": \"Stage Manager: It seems some cat has stolen your tongue. Do you mind checking your “device” again?\"}",
