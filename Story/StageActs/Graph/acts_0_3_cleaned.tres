"3_41": {"signalValue": "frame:{\"id\": \"A3_4_Conflict\", \"group\": \"Act 3\", \"cue\": \"\", \"routes\": [\"choice_0\", \"choice_1\", \"choice_2\", \"takeover\"], \"effects\": [{\"set\": {\"finalResponse\": \"follow_play\"}}, {\"set\": {\"finalResponse\": \"engage_actor2\"}}, {\"set\": {\"finalResponse\": \"neither\"}}, {\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 2 steps closer, marching towards the MC, ignoring actor 1 who is trying to keep the performance alive.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Why writing?\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"he raise the stake, abruptly cutting the ACTOR 1's line\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Because you love it?\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Or because someone handed you the answer?\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor turns around and  reaches toward you.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Darling.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Ignore him.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"The guests are waiting.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"For the first time, there is no single obvious instruction.\"}], \"context\": \"\", \"player_task\": \"Respond in context: Follow Actor 1 / continue ceremony; Answer Actor 2 / explain why writing; Relevant rejection of both roles\", \"author_notes\": [\"Response words above are editable. USE UNIVERSAL uses Universal responses. Takeover wording is provisional; review before recording. Buttons in Play simulate player meanings.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"choice_0\": {\"meaning\": \"Follow Actor 1 / continue ceremony\", \"destination\": \"A3_4_FollowPlay\"}, \"choice_1\": {\"meaning\": \"Answer Actor 2 / explain why writing\", \"destination\": \"A3_4_EngageActor2\"}, \"choice_2\": {\"meaning\": \"Relevant rejection of both roles\", \"destination\": \"A3_4_Unexpected\"}}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"response_overrides\": {\"SILENCE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: We are waiting for your line.\"}, \"OFFSCRIPT\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Stay with the script.\"}, \"UNCLEAR\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}, \"TECHNICAL_FAILURE\": {\"action\": \"stay\", \"reply\": \"Stage Manager: Hello? I can't hear you well. Repeat again.\"}}, \"template_version\": 2, \"conversation\": \"A3_4_Conflict\", \"intro_exempt\": false, \"takeover_start\": \"TAKEOVER::A3_4_Conflict\", \"mic_check_reply\": \"Stage Manager: It seems some cat has stolen your tongue. Do you mind checking your “device” again?\"}",
