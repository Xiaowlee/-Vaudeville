ation\", \"speaker\": \"\", \"text\": \"Actor turns around and  reaches toward you.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Darling.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Ignore him.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"The guests are waiting.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"For the first time, there is no single obvious instruction.\"}], \"context\": \"The decision is whom the player follows: ACTOR 1, Actor 2, or neither. The current story supplies one reaction for each.\", \"player_task\": \"Respond to the current scene.\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"choice_0\": {\"meaning\": \"Follow ACTOR 1 and continue the ceremony.\", \"destination\": \"A3_4_FollowPlay\"}, \"choice_1\": {\"meaning\": \"Respond to Actor 2.\", \"destination\": \"A3_4_EngageActor2\"}, \"choice_2\": {\"meaning\": \"Say something neither of them expected.\", \"destination\": \"A3_4_Unexpected\"}}, \"response_overrides\": {}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"narrative_purpose\": \"\", \"mc_behaviour\": [], \"npc_behaviour\": [], \"assets_required\": [], \"state_changes\": {}, \"missing_logic\": []}"
