"3_42": {"signalValue": "frame:{\"id\": \"A3_4_EngageActor2\", \"group\": \"Act 3\", \"cue\": \"\", \"routes\": [\"next\"], \"effects\": [{\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"You turn toward Actor 2 instead.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"ACTOR 1 freezes.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"For a moment, nobody backstage seems to know what to do.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 2 lowers his voice.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Good.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"You heard that Karl. You can't help hiding it forever.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Yelled, But he does not look at the audience, at MC, at actor 1. Rather, he turns himself at a pointblank space on the screen\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"response_overrides\": {}, \"template_version\": 2}",
