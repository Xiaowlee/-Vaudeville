"signalValue": "frame:{\"id\": \"A2_0_DeclarationDay\", \"cue\": \"NEITHER DO I. IT GET A LITTLE NERVOUS.\", \"routes\": [\"choice_0\"], \"effects\": [{\"increment\": 0, \"reason\": \"\", \"set\": {}}], \"thresholds\": {\"Correction\": 1, \"Disruption\": 3, \"KickOut\": 5}, \"notices\": {\"correction\": \"STAGE MANAGER — CORRECTION A sharp cue flashes across your phone: “Stay with the script.” The audience hesitates, then the performance continues.\", \"disruption\": \"CONTROL DISRUPTION The image tears into strips. For a moment, the MC moves before you tell her to. The Stage Manager forces the scene back into place.\"}, \"endgame\": \"A0_Endgame\", \"reset\": false, \"boundary\": false, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"coverage\": 0.8, \"group\": \"Act 2\", \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Before you can start the game, on the second screen, you see a spark of light cast on a thin long lines. It runs through quickly before disappear. It happens almost immediate.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"And then the Stage manager standing from the other side (on your computer), elegantly walk out, still with his despise look on you.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"One month passes.\\nThe day of the celebration finally arrives.\\nPeople from around the kingdom gather for the princess's birthday and declaration.\"}, {\"kind\": \"stage\", \"speaker\": \"\", \"text\": \"The curtain once again unveil\\nThe stage changes from the family home into the preparation for the princess's eighteenth birthday.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The hall is crowded.\\nMusicians prepare.\\nServants and performers move around the stage.\\nThe princess is preparing to appear before everyone.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Both of the actors, including the one you are controlling, walks out.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 1 approaches you from the side, gently nudge the MC elbow.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Look at that, child.\\nToday is the day.\\nI can not believe it.\\nYou're gonna be a true adult.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The MC girl, ironically look confused, she keeps staring at the actor. But not for long because the cue has again appear on the other side.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"NEITHER DO I. IT GET A LITTLE NERVOUS.\"}], \"context\": \"\", \"player_task\": \"Read the phone cue aloud.\", \"author_notes\": [\"REVIEW: Act 1 says the birthday is tomorrow; this narration says one month passes. Original wording preserved.\"], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {\"choice_0\": {\"meaning\": \"Read the cue.\", \"destination\": \"A2_1_Entrance\"}}, \"response_overrides\": {}, \"bounded_evidence\": {}, \"input_mode\": \"speech\", \"narrative_purpose\": \"\", \"mc_behaviour\": [], \"npc_behaviour\": [], \"assets_required\": [], \"state_changes\": {}, \"missing_logic\": []}"
},
