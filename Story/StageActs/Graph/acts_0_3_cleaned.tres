"3_40": {"signalValue": "frame:{\"id\": \"A3_3_ACTOR 1Interrupts\", \"group\": \"Act 3\", \"cue\": \"STAGE MANAGER / IFB: — KEEP THE PLAY MOVING.\", \"routes\": [\"next\"], \"effects\": [{\"set\": {}}], \"endgame\": \"A0_Endgame\", \"reset\": false, \"coverage\": 0.8, \"yes\": [\"yes\", \"yeah\", \"sure\", \"okay\", \"ok\", \"ready\", \"lets begin\"], \"no\": [\"no\", \"not yet\", \"not ready\", \"wait\"], \"ambition\": [\"writer\", \"write\", \"become\", \"want\", \"dream\", \"aspire\", \"career\", \"astronaut\", \"doctor\", \"artist\"], \"events\": [{\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The Stage manager makes a morse code light signal, pointing towards Actor 1.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"It takes her 3 seconds, before stepping between you and the guy. pushing him to the side.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"The music in the hall speeds up.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Enough.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"Her decision has been made.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 1\", \"text\": \"We are here to celebrate my daughter's eighteenth birthday and declaration.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Actor 2 looks past her.\"}, {\"kind\": \"dialogue\", \"speaker\": \"Actor 2\", \"text\": \"Then let her tell us herself.\"}, {\"kind\": \"narration\", \"speaker\": \"\", \"text\": \"Your phone vibrates again.\"}, {\"kind\": \"phone\", \"speaker\": \"\", \"text\": \"STAGE MANAGER / IFB: — KEEP THE PLAY MOVING.\"}], \"context\": \"\", \"player_task\": \"\", \"author_notes\": [], \"grammar_warnings\": [], \"production_hooks\": {\"ON ENTER\": [], \"ON LISTEN\": [], \"ON ACCEPT\": [], \"ON UNCLEAR\": [], \"ON SILENCE\": [], \"ON QUESTION\": [], \"ON OFFSCRIPT\": []}, \"allowed_authored_intents\": {}, \"bounded_evidence\": {}, \"input_mode\": \"continue\", \"response_overrides\": {}, \"template_version\": 2}",
