[sub_resource type="Resource" id="Resource_wvkp1"]
script = ExtResource("13_wg7fo")
stage_description = "A small storybook-like section of the stage becomes visible.

Do NOT reveal the full theatre yet.

A warm light reveals a family tableau.

The Princess appears first as a child.

Other figures surround her.

The scene should feel artificial and theatrical, like actors creating a fairy tale in front of an audience."
actor_actions = Array[ExtResource("2_l3c0v")]([SubResource("Action_0_0"), SubResource("Action_0_1"), SubResource("Action_0_2")])
ambience = Array[ExtResource("3_gkxkd")]([SubResource("Resource_qyty3")])
delay_after_response = 0.0
sfx_on_start = Array[AudioStream]([null])

