[sub_resource type="Resource" id="Resource_2ysuu"]
script = ExtResource("13_wg7fo")
stage_description = "The remaining lights fade.

The curtains completely close.

Audience ambience grows slightly louder.

Time passes.

Backstage movement can be heard.

Sets are rearranged behind the curtain.

Music begins.

The curtains slowly OPEN.

THIS is the first major reveal of the full stage.

The small fairy-tale tableau has transformed into a large birthday / declaration hall.

There are decorations.

Musicians are positioned nearby.

People move around preparing the ceremony.

The stage should now feel significantly larger than Act 1."
notes = "Narration is presented while the curtain is closed; actual opening completion gates Act 2. TODO: audience murmurs, backstage movement and authored music/lighting assets."
delay_after_response = 0.0

