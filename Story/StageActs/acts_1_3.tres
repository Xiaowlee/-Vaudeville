[sub_resource type="Resource" id="Resource_32stb"]
script = ExtResource("13_wg7fo")
stage_description = "Mother subtly raises one hand toward backstage.

She makes a small signalling gesture.

Someone behind the curtain notices.

A backstage worker / prompter prepares assistance.

After a short delay:

A cue appears.

THIS IS THE FIRST TIME THE PLAYER SEES THE PROMPTER.

It should feel like something backstage has been sent to rescue the performance."
