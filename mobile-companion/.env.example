# Local development (npm run dev): use THIS computer's current Wi-Fi IPv4 address, not localhost.
# localhost on a phone is the phone itself. Example at home: wss://192.168.0.61:8787
NEXT_PUBLIC_RELAY_URL=wss://10.132.36.229:8787

# Vercel: public HTTPS address of the separate relay (no path), e.g. https://vaudeville-relay.onrender.com
# Used by /play so the browser game creates its phone session on the relay.
NEXT_PUBLIC_RELAY_ORIGIN=
